# Copy to .env.local (git-ignored) and fill in. Only public values belong here:
# the browser can read everything in this file.
VITE_API_BASE_URL=http://localhost:8082
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# The PUBLISHABLE (anon) key. Never the secret/service key.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
