# Copy to .env for local runs (git-ignored). Staging/production values come
# from Google Secret Manager mounted into Cloud Run. NEVER commit real secrets.
DASHURI_ENV=development
PORT=8080
SUPPORT_EMAIL=support@example.com

# Dedicated least-privilege role `api_service`, via the Supabase pooler (not the service-role key).
DATABASE_URL=postgres://api_service:CHANGE_ME@localhost:54322/postgres?sslmode=disable

# Supabase Auth (JWT verification). Production projects use asymmetric signing keys (JWKS).
SUPABASE_URL=http://localhost:54321
SUPABASE_JWKS_URL=http://localhost:54321/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=http://localhost:54321/auth/v1
# Development only: legacy HS256 secret of a local `supabase start` stack. Refused in staging/production.
SUPABASE_DEV_JWT_SECRET=
# Server-only key used to publish Realtime broadcasts and sign Storage upload URLs.
SUPABASE_REALTIME_SERVICE_KEY=
SUPABASE_STORAGE_SERVICE_KEY=

# Google Play Billing (default rail) + Play Integrity + FCM: one service account JSON file.
PLAY_PACKAGE_NAME=com.bkenterprises.dashuri
GOOGLE_APPLICATION_CREDENTIALS=
PLAY_RTDN_AUDIENCE=
PLAY_RTDN_SERVICE_ACCOUNT=
FCM_PROJECT_ID=

# Cashfree PG (second rail, ADR-011). Keep false until written category approval + billing-policy decision.
CASHFREE_ENABLED=false
CASHFREE_ENV=sandbox
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_API_VERSION=2025-01-01
CASHFREE_RETURN_URL=

# Stream Video (ADR-005). Webhook URL: https://<api-host>/v1/webhooks/video/stream
STREAM_API_KEY=
STREAM_API_SECRET=

# Nudity checks during the first 3 minutes of each call (S7, ADR-013).
MODERATION_ENABLED=true
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=

# Keep false until incorporation + payout provider onboarding (founder decision R3-7).
PAYOUTS_ENABLED=false
FREE_CALL_ENABLED=true

# Admin web console origins allowed by CORS (comma-separated). Empty = CORS off.
ADMIN_ORIGINS=

# Virtual gifts during calls (docs/gifts/VIRTUAL_GIFTS.md). Needs migrations
# 20261123000200 + 20261126000200 applied FIRST and CHAT_MESSAGE_CONTEXT_ENABLED=true.
GIFTS_ENABLED=false
# Host arrival photos (docs/host/HOST_HOME_SESSION_AND_ARRIVAL_PHOTO.md). Needs
# migration 20261126000100 applied FIRST.
ARRIVAL_PHOTOS_ENABLED=false
# FOUNDER DECISION: publish validated arrival photos without an automated
# nudity scan when no classifier is configured (default false = staff review).
ARRIVAL_PHOTO_AUTO_APPROVE_UNSCANNED=false

# Reels (EXPERIMENT, docs/reels). Needs migrations 20261123000100 +
# 20261127000100 applied FIRST. New uploads go to REELS_VIDEO_PROVIDER:
# r2 (target: Cloudflare R2 + our own ffmpeg processing in the media worker,
# docs/reels/DASHURI_REELS_R2_MIGRATION.md) or mux (transition only).
REELS_ENABLED=false
REELS_VIDEO_PROVIDER=r2
# Cloudflare R2 (private bucket; S3 API token scoped to that one bucket,
# Object Read & Write). Leave empty: uploads answer 503 until set.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional: an S3-compatible endpoint for local testing (e.g. MinIO).
R2_ENDPOINT=
# Keep the uploaded original after processing (default false: smaller bill).
R2_KEEP_ORIGINALS=false
# Mux: only while reels stored with Mux still exist.
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_SIGNING_KEY_ID=
MUX_SIGNING_KEY_PRIVATE=
MUX_WEBHOOK_SECRET=
REELS_MODERATION_FRAME_SECONDS=2
